# =============================================================================
# Northstar Assist - environment configuration
# Copy to .env and fill in.  .env is gitignored (repo root .gitignore:7).
# NEVER put real values in this template file - it IS tracked by git.
# =============================================================================

# --- AWS credentials -------------------------------------------------------
# Lab / SSO accounts issue a TRIPLE. All three are required.
# Missing or expired AWS_SESSION_TOKEN => "InvalidClientTokenId".
# Leave AWS_SESSION_TOKEN blank only for a permanent IAM user access key.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# --- Model selection -------------------------------------------------------
# Switch to amazon.nova-lite-v1:0 if Claude 3.7 Sonnet is unavailable.
FM_MODEL_ID=us.anthropic.claude-3-7-sonnet-20250219-v1:0
EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
EMBED_DIMENSION=1024

# --- Populated automatically by scripts/ (do not hand-edit) ----------------
AWS_ACCOUNT_ID=
KB_S3_BUCKET=
VECTOR_BUCKET=
VECTOR_INDEX=
BEDROCK_KB_ID=
BEDROCK_DS_ID=
BEDROCK_AGENT_ID=
BEDROCK_AGENT_ALIAS_ID=
AGENT_ROLE_NAME=
KB_ROLE_NAME=
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=
LOG_GROUP=/aws/bedrock/northstar-assist
SNS_TOPIC_ARN=

# --- Monitoring ---
# Address that CloudWatch alarms notify. The SNS subscription must be
# confirmed by email or alerts silently go nowhere.
ALERT_EMAIL=

# --- Streamlit reference app ----------------------------------------------
APP_PASSWORD=

# Set only if behind a TLS-inspecting proxy (e.g. Zscaler). See docs/00-UI-PREREQUISITES.md 1.0.
AWS_CA_BUNDLE=
